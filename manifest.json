{
  "manifest_version": 3,
  "name": "CPA to sub2api Converter",
  "version": "1.0.0",
  "description": "在浏览器本地批量将 CPA 账号 JSON 转换为 sub2api JSON。",
  "offline_enabled": true,
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CPA Converter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
